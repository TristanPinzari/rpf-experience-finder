{
  "name": "rfp-server",
  "version": "1.0.0",
  "scripts": {
    "generate": "tsx src/scripts/generate-archive.ts",
    "ingest": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/ingest.ts",
    "eval:extraction": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/eval-extraction.ts",
    "typecheck": "tsc --noEmit",
    "search": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/search.ts",
    "dev": "node --no-warnings=ExperimentalWarning --import tsx --watch src/server.ts",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/server.ts",
    "eval:search": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/eval-search.ts"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.26.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
