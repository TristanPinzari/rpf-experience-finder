# Gemini API key from https://aistudio.google.com/apikey (enable billing for usable rate limits)
GEMINI_API_KEY=
# Chat model used for generation, extraction and ranking
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to switch to when the main one is overloaded (HTTP 503)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Embedding model
GEMINI_EMBED_MODEL=gemini-embedding-2
# Minimum gap between API call starts. Paid key: 1000. Free tier: 13000 (5 requests/minute).
GEMINI_MIN_INTERVAL_MS=1000
# How many LLM calls scripts run at the same time. Free tier: 1.
LLM_CONCURRENCY=4
